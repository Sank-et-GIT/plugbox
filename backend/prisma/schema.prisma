// ─────────────────────────────────────────────────────────────────────────────
// schema.prisma — PlugBox v2 Final Schema (Bug-fixed version)
//
// Fixes from review:
//   1. WalletTransaction now has proper @relation to Session + Booking
//   2. Session has plugWaitStartedAt field (for accurate 3min timeout)
//   3. Back-relations added to Session + Booking for WalletTransaction
//
// Run migration:
//   npx prisma migrate dev --name v2_complete
// ─────────────────────────────────────────────────────────────────────────────

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────────────────────────────────────
// User
// ─────────────────────────────────────────────────────────────────────────────
model User {
  id          String   @id @default(uuid())
  phone       String   @unique
  firebaseUid String   @unique
  name        String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wallet   Wallet?
  bookings Booking[]
  sessions Session[]

  @@index([phone])
  @@index([firebaseUid])
}

// ─────────────────────────────────────────────────────────────────────────────
// Wallet
// balance = spendable, in paise (₹1 = 100 paise)
// deposit = ₹100 locked security deposit, in paise
// ─────────────────────────────────────────────────────────────────────────────
model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Int      @default(0)
  deposit   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// WalletTransaction
// FIX: proper @relation to Session and Booking added
// ─────────────────────────────────────────────────────────────────────────────
enum WalletTxnType {
  TOPUP
  PACKAGE_DEBIT
  REFUND
  DEPOSIT_COLLECT
  DEPOSIT_REFUND
}

model WalletTransaction {
  id           String        @id @default(uuid())
  walletId     String
  type         WalletTxnType
  amountPaise  Int
  balancePaise Int
  note         String?
  sessionId    Int?
  bookingId    Int?
  razorpayId   String?
  createdAt    DateTime      @default(now())

  wallet  Wallet   @relation(fields: [walletId], references: [id])
  session Session? @relation(fields: [sessionId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([walletId, createdAt])
  @@index([sessionId])
  @@index([bookingId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Location
// ─────────────────────────────────────────────────────────────────────────────
model Location {
  id        Int      @id @default(autoincrement())
  name      String
  address   String
  lat       Float
  lng       Float
  createdAt DateTime @default(now())

  chargers Charger[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Charger
// ─────────────────────────────────────────────────────────────────────────────
model Charger {
  id          Int       @id @default(autoincrement())
  locationId  Int?
  slotNumber  Int       @default(1)
  name        String
  displayName String    @default("PlugBox #1")
  lat         Float
  lng         Float
  status      String    @default("OFFLINE")
  deviceId    String?   @unique
  mqttTopic   String?
  lastSeen    DateTime?
  createdAt   DateTime  @default(now())

  location       Location?       @relation(fields: [locationId], references: [id])
  bookings       Booking[]
  sessions       Session[]
  commands       DeviceCommand[]
  energyReadings EnergyReading[]

  @@index([deviceId])
  @@index([locationId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Booking
// FIX: walletTransactions back-relation added
// ─────────────────────────────────────────────────────────────────────────────
enum BookingStatus {
  HOLD
  EXPIRED
  CANCELLED
  STARTED
}

model Booking {
  id           Int           @id @default(autoincrement())
  chargerId    Int
  userId       String
  packageName  String
  packagePaise Int
  kwhLimit     Float
  status       BookingStatus @default(HOLD)
  walletTxnId  String?
  expiresAt    DateTime
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  charger            Charger             @relation(fields: [chargerId], references: [id])
  user               User                @relation(fields: [userId], references: [id])
  sessions           Session[]
  walletTransactions WalletTransaction[]

  @@index([chargerId])
  @@index([userId])
  @@index([status, expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Session
// FIX 1: walletTransactions back-relation added
// FIX 2: plugWaitStartedAt added (for accurate 3min timeout — not fragile)
// ─────────────────────────────────────────────────────────────────────────────
enum SessionStatus {
  CREATED
  UNLOCK_SENT
  UNLOCKED
  PLUG_WAIT
  ACTIVE
  ENDED
  FAILED
}

model Session {
  id                Int           @id @default(autoincrement())
  chargerId         Int
  userId            String
  bookingId         Int
  status            SessionStatus @default(CREATED)
  buttonAttempts    Int           @default(0)
  finalKwh          Float?
  startedAt         DateTime?
  endedAt           DateTime?
  plugWaitStartedAt DateTime?     // FIX: set when status → PLUG_WAIT, used for 3min timeout
  walletTxnId       String?
  refundTxnId       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  charger            Charger             @relation(fields: [chargerId], references: [id])
  user               User                @relation(fields: [userId], references: [id])
  booking            Booking             @relation(fields: [bookingId], references: [id])
  commands           DeviceCommand[]
  energyReadings     EnergyReading[]
  walletTransactions WalletTransaction[]

  @@index([chargerId, status])
  @@index([userId])
  @@index([bookingId])
  @@index([status, plugWaitStartedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// DeviceCommand
// ─────────────────────────────────────────────────────────────────────────────
enum CommandType {
  UNLOCK
}

enum CommandStatus {
  PENDING
  ACKED
  FAILED
}

model DeviceCommand {
  id        Int           @id @default(autoincrement())
  chargerId Int
  sessionId Int?
  type      CommandType
  status    CommandStatus @default(PENDING)
  payload   Json?
  createdAt DateTime      @default(now())
  ackedAt   DateTime?

  charger Charger  @relation(fields: [chargerId], references: [id])
  session Session? @relation(fields: [sessionId], references: [id])

  @@index([chargerId, status])
  @@index([sessionId])
}

// ─────────────────────────────────────────────────────────────────────────────
// EnergyReading
// ─────────────────────────────────────────────────────────────────────────────
model EnergyReading {
  id          Int      @id @default(autoincrement())
  chargerId   Int
  sessionId   Int?
  voltage     Float
  current     Float
  power       Float
  energyKwh   Float
  frequency   Float
  powerFactor Float
  kept        Boolean  @default(false)
  createdAt   DateTime @default(now())

  charger Charger  @relation(fields: [chargerId], references: [id])
  session Session? @relation(fields: [sessionId], references: [id])

  @@index([chargerId, createdAt])
  @@index([sessionId, createdAt])
  @@index([kept, createdAt])
}
