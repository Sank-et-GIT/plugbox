generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(uuid())
  phone       String    @unique
  name        String    @default("")
  email       String?   @unique
  password    String?   @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  firebaseUid String    @unique
  isActive    Boolean   @default(true)
  lastLogin   DateTime?
  role        String    @default("user")
  bookings    Booking[]
  sessions    Session[]
  vendor      Vendor?
  wallet      Wallet?

  @@index([phone])
  @@index([firebaseUid])
  @@index([email])
}

model Vendor {
  id            String    @id @default(uuid())
  userId        String    @unique
  companyName   String?
  email         String    @unique
  phoneNumber   String
  password      String
  isActive      Boolean   @default(true)
  status        String    @default("ACTIVE")
  kycStatus     String    @default("PENDING")
  walletBalance Float     @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLogin     DateTime?
  chargers      Charger[]
  user          User      @relation(fields: [userId], references: [id])

  @@index([email])
}

model Wallet {
  id           String              @id @default(uuid())
  userId       String              @unique
  balance      Int                 @default(0)
  deposit      Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]

  @@index([userId])
}

model WalletTransaction {
  id           String        @id @default(uuid())
  walletId     String
  type         WalletTxnType
  amountPaise  Int
  balancePaise Int
  note         String?
  sessionId    Int?
  bookingId    Int?
  razorpayId   String?
  createdAt    DateTime      @default(now())
  booking      Booking?      @relation(fields: [bookingId], references: [id])
  session      Session?      @relation(fields: [sessionId], references: [id])
  wallet       Wallet        @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt])
  @@index([sessionId])
  @@index([bookingId])
}

model Location {
  id        Int       @id @default(autoincrement())
  name      String
  address   String
  lat       Float
  lng       Float
  createdAt DateTime  @default(now())
  chargers  Charger[]
}

model Charger {
  id             Int             @id @default(autoincrement())
  name           String
  lat            Float
  lng            Float
  status         String          @default("OFFLINE")
  createdAt      DateTime        @default(now())
  lastSeen       DateTime?
  deviceId       String?         @unique
  displayName    String          @default("PlugBox #1")
  locationId     Int?
  mqttTopic      String?
  slotNumber     Int             @default(1)
  vendorId       String?
  bookings       Booking[]
  location       Location?       @relation(fields: [locationId], references: [id])
  vendor         Vendor?         @relation(fields: [vendorId], references: [id])
  commands       DeviceCommand[]
  energyReadings EnergyReading[]
  sessions       Session[]

  @@index([deviceId])
  @@index([locationId])
  @@index([status])
  @@index([vendorId])
}

model Booking {
  id                 Int                 @id @default(autoincrement())
  chargerId          Int
  userId             String
  status             BookingStatus       @default(HOLD)
  createdAt          DateTime            @default(now())
  expiresAt          DateTime
  updatedAt          DateTime            @updatedAt
  kwhLimit           Float
  packageName        String
  packagePaise       Int
  walletTxnId        String?
  charger            Charger             @relation(fields: [chargerId], references: [id])
  user               User                @relation(fields: [userId], references: [id])
  sessions           Session[]
  walletTransactions WalletTransaction[]

  @@index([chargerId])
  @@index([userId])
  @@index([status, expiresAt])
}

model Session {
  id                 Int                 @id @default(autoincrement())
  chargerId          Int
  userId             String
  status             SessionStatus       @default(CREATED)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  endedAt            DateTime?
  startedAt          DateTime?
  bookingId          Int
  buttonAttempts     Int                 @default(0)
  finalKwh           Float?
  refundTxnId        String?
  walletTxnId        String?
  plugWaitStartedAt  DateTime?
  commands           DeviceCommand[]
  energyReadings     EnergyReading[]
  booking            Booking             @relation(fields: [bookingId], references: [id])
  charger            Charger             @relation(fields: [chargerId], references: [id])
  user               User                @relation(fields: [userId], references: [id])
  walletTransactions WalletTransaction[]

  @@index([chargerId, status])
  @@index([userId])
  @@index([bookingId])
  @@index([status, plugWaitStartedAt])
}

model DeviceCommand {
  id        Int           @id @default(autoincrement())
  chargerId Int
  type      CommandType
  status    CommandStatus @default(PENDING)
  payload   Json?
  createdAt DateTime      @default(now())
  ackedAt   DateTime?
  sessionId Int?
  charger   Charger       @relation(fields: [chargerId], references: [id])
  session   Session?      @relation(fields: [sessionId], references: [id])

  @@index([chargerId, status])
  @@index([sessionId])
}

model EnergyReading {
  id          Int      @id @default(autoincrement())
  chargerId   Int
  sessionId   Int?
  voltage     Float
  current     Float
  power       Float
  energyKwh   Float
  frequency   Float
  powerFactor Float
  kept        Boolean  @default(false)
  createdAt   DateTime @default(now())
  charger     Charger  @relation(fields: [chargerId], references: [id])
  session     Session? @relation(fields: [sessionId], references: [id])

  @@index([chargerId, createdAt])
  @@index([sessionId, createdAt])
  @@index([kept, createdAt])
}

enum WalletTxnType {
  TOPUP
  PACKAGE_DEBIT
  REFUND
  DEPOSIT_COLLECT
  DEPOSIT_REFUND
}

enum BookingStatus {
  HOLD
  EXPIRED
  CANCELLED
  STARTED
}

enum SessionStatus {
  CREATED
  UNLOCK_SENT
  UNLOCKED
  ACTIVE
  ENDED
  FAILED
  PLUG_WAIT
}

enum CommandType {
  UNLOCK
}

enum CommandStatus {
  PENDING
  ACKED
  FAILED
}
