// ─────────────────────────────────────────────────────────────────────────────
// schema.prisma
//
// CHANGES FROM PREVIOUS VERSION:
//   • OtpLog model REMOVED — Firebase handles OTP, we don't store it
//   • User model KEPT — we still store phone, name, createdAt in our DB
//
// After editing run:
//   npx prisma migrate dev --name add_user_firebase_auth
// ─────────────────────────────────────────────────────────────────────────────

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────────────────────────────────────
// User
// phone = verified by Firebase (format: +91XXXXXXXXXX)
// firebaseUid = Firebase's uid — useful for future Firebase features
// userId in Booking/Session maps to this User's id (UUID string)
// ─────────────────────────────────────────────────────────────────────────────
model User {
  id          String   @id @default(uuid())
  phone       String   @unique
  firebaseUid String   @unique         // Firebase uid from idToken
  name        String   @default("")    // set in signup step 3
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phone])
  @@index([firebaseUid])
}

// ─────────────────────────────────────────────────────────────────────────────
// EXISTING — untouched
// ─────────────────────────────────────────────────────────────────────────────

model Charger {
  id        Int       @id @default(autoincrement())
  name      String
  lat       Float
  lng       Float
  status    String
  lastSeen  DateTime?
  createdAt DateTime  @default(now())

  bookings Booking[]
  sessions Session[]
  commands DeviceCommand[]
}

enum BookingStatus {
  HOLD
  EXPIRED
  CANCELLED
  STARTED
}

model Booking {
  id        Int           @id @default(autoincrement())
  chargerId Int
  userId    String
  status    BookingStatus @default(HOLD)

  createdAt DateTime @default(now())
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  charger Charger @relation(fields: [chargerId], references: [id])

  @@index([chargerId])
  @@index([userId])
}

enum SessionStatus {
  CREATED
  UNLOCK_SENT
  UNLOCKED
  ACTIVE
  ENDED
  FAILED
}

enum CommandType {
  UNLOCK
}

enum CommandStatus {
  PENDING
  ACKED
}

model Session {
  id        Int           @id @default(autoincrement())
  chargerId Int
  userId    String
  status    SessionStatus @default(CREATED)

  startedAt DateTime?
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  charger  Charger         @relation(fields: [chargerId], references: [id])
  commands DeviceCommand[]

  @@index([chargerId])
  @@index([userId])
}

model DeviceCommand {
  id        Int           @id @default(autoincrement())
  chargerId Int
  type      CommandType
  status    CommandStatus @default(PENDING)

  payload Json?

  createdAt DateTime  @default(now())
  ackedAt   DateTime?
  sessionId Int?

  charger Charger  @relation(fields: [chargerId], references: [id])
  session Session? @relation(fields: [sessionId], references: [id])

  @@index([chargerId, status])
}
