// ─────────────────────────────────────────────────────────────────────────────
// schema.prisma — PlugBox v2
//
// Changes in this version:
//   1. Session.kwhAtStart (Float?) — stores PZEM counter when session → ACTIVE
//      Billing delta = kwhAtStop - kwhAtStart (protects against RESET_ENERGY
//      timing issues between sessions)
//   2. BookingStatus.FAILED — set when a session fails so booking records are
//      consistent and can be queried/filtered properly
//
// Migration:
//   npx prisma migrate dev --name add_kwh_at_start_booking_failed
//   npx prisma generate
// ─────────────────────────────────────────────────────────────────────────────

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────────────────────────────────────
// User
// ─────────────────────────────────────────────────────────────────────────────
model User {
  id          String   @id @default(uuid())
  phone       String   @unique
  firebaseUid String   @unique
  name        String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wallet   Wallet?
  bookings Booking[]
  sessions Session[]

  @@index([phone])
  @@index([firebaseUid])
}

// ─────────────────────────────────────────────────────────────────────────────
// Wallet
// balance = spendable, in paise (₹1 = 100 paise)
// deposit = ₹100 locked security deposit, in paise
// ─────────────────────────────────────────────────────────────────────────────
model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Int      @default(0)
  deposit   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// WalletTransaction
// ─────────────────────────────────────────────────────────────────────────────
enum WalletTxnType {
  TOPUP
  PACKAGE_DEBIT
  REFUND
  DEPOSIT_COLLECT
  DEPOSIT_REFUND
}

model WalletTransaction {
  id           String        @id @default(uuid())
  walletId     String
  type         WalletTxnType
  amountPaise  Int
  balancePaise Int
  note         String?
  sessionId    Int?
  bookingId    Int?
  razorpayId   String?
  createdAt    DateTime      @default(now())

  wallet  Wallet   @relation(fields: [walletId], references: [id])
  session Session? @relation(fields: [sessionId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([walletId, createdAt])
  @@index([sessionId])
  @@index([bookingId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Location
// ─────────────────────────────────────────────────────────────────────────────
model Location {
  id        Int      @id @default(autoincrement())
  name      String
  address   String
  lat       Float
  lng       Float
  createdAt DateTime @default(now())

  chargers Charger[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Charger
// ─────────────────────────────────────────────────────────────────────────────
model Charger {
  id          Int       @id @default(autoincrement())
  locationId  Int?
  slotNumber  Int       @default(1)
  name        String
  displayName String    @default("PlugBox #1")
  lat         Float
  lng         Float
  status      String    @default("OFFLINE")
  deviceId    String?   @unique
  mqttTopic   String?
  lastSeen    DateTime?
  createdAt   DateTime  @default(now())

  location       Location?       @relation(fields: [locationId], references: [id])
  bookings       Booking[]
  sessions       Session[]
  commands       DeviceCommand[]
  energyReadings EnergyReading[]

  @@index([deviceId])
  @@index([locationId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Booking
//
// Status flow:
//   HOLD → STARTED (when session begins)
//        → EXPIRED (booking window passed)
//        → CANCELLED (user cancelled)
//        → FAILED   (session failed — door timeout, emergency, reboot, etc.)
// ─────────────────────────────────────────────────────────────────────────────
enum BookingStatus {
  HOLD
  EXPIRED
  CANCELLED
  STARTED
  FAILED   // NEW: session failed — refund issued, booking closed
}

model Booking {
  id           Int           @id @default(autoincrement())
  chargerId    Int
  userId       String
  packageName  String
  packagePaise Int
  kwhLimit     Float
  status       BookingStatus @default(HOLD)
  walletTxnId  String?
  expiresAt    DateTime
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  charger            Charger             @relation(fields: [chargerId], references: [id])
  user               User                @relation(fields: [userId], references: [id])
  sessions           Session[]
  walletTransactions WalletTransaction[]

  @@index([chargerId])
  @@index([userId])
  @@index([status, expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Session
//
// Status machine:
//   CREATED → UNLOCK_SENT → PLUG_WAIT → ACTIVE → ENDED
//                                              → FAILED
//
// kwhAtStart: PZEM cumulative counter value at the moment session → ACTIVE.
//   Stored so billing uses a delta (kwhAtStop - kwhAtStart) rather than the
//   raw PZEM counter, which protects against RESET_ENERGY timing issues.
//
// plugWaitStartedAt: set once when session enters PLUG_WAIT. Used by the
//   sessionTimeout job for an accurate 5-minute timer.
// ─────────────────────────────────────────────────────────────────────────────
enum SessionStatus {
  CREATED
  UNLOCK_SENT
  UNLOCKED
  PLUG_WAIT
  ACTIVE
  ENDED
  FAILED
}

model Session {
  id                Int           @id @default(autoincrement())
  chargerId         Int
  userId            String
  bookingId         Int
  status            SessionStatus @default(CREATED)
  buttonAttempts    Int           @default(0)
  kwhAtStart        Float?        // NEW: PZEM counter snapshot when → ACTIVE
  finalKwh          Float?        // delta kWh used = finalKwh - kwhAtStart
  startedAt         DateTime?
  endedAt           DateTime?
  plugWaitStartedAt DateTime?     // set once on → PLUG_WAIT, used for 5min timeout
  walletTxnId       String?
  refundTxnId       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  charger            Charger             @relation(fields: [chargerId], references: [id])
  user               User                @relation(fields: [userId], references: [id])
  booking            Booking             @relation(fields: [bookingId], references: [id])
  commands           DeviceCommand[]
  energyReadings     EnergyReading[]
  walletTransactions WalletTransaction[]

  @@index([chargerId, status])
  @@index([userId])
  @@index([bookingId])
  @@index([status, plugWaitStartedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// DeviceCommand — audit trail for all commands sent to hardware
// ─────────────────────────────────────────────────────────────────────────────
enum CommandType {
  UNLOCK
}

enum CommandStatus {
  PENDING
  ACKED
  FAILED
}

model DeviceCommand {
  id        Int           @id @default(autoincrement())
  chargerId Int
  sessionId Int?
  type      CommandType
  status    CommandStatus @default(PENDING)
  payload   Json?
  createdAt DateTime      @default(now())
  ackedAt   DateTime?

  charger Charger  @relation(fields: [chargerId], references: [id])
  session Session? @relation(fields: [sessionId], references: [id])

  @@index([chargerId, status])
  @@index([sessionId])
}

// ─────────────────────────────────────────────────────────────────────────────
// EnergyReading — raw PZEM-004T telemetry, stored every ~500ms during session
// ─────────────────────────────────────────────────────────────────────────────
model EnergyReading {
  id          Int      @id @default(autoincrement())
  chargerId   Int
  sessionId   Int?
  voltage     Float
  current     Float
  power       Float
  energyKwh   Float
  frequency   Float
  powerFactor Float
  kept        Boolean  @default(false)
  createdAt   DateTime @default(now())

  charger Charger  @relation(fields: [chargerId], references: [id])
  session Session? @relation(fields: [sessionId], references: [id])

  @@index([chargerId, createdAt])
  @@index([sessionId, createdAt])
  @@index([kept, createdAt])
}
